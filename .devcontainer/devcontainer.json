{
  "name": "Geonomia Gazetteer",
  "image": "mcr.microsoft.com/devcontainers/python:3-bullseye",
  "postCreateCommand": "bash scripts/install-linux.sh && make install",
  "forwardPorts": [8001],
  "portsAttributes": {
    "8001": {
      "label": "Datasette",
      "onAutoForward": "notify"
    }
  }
}
